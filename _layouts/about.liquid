---
layout: default
---
<div class="post">
  <article>
    {% if page.profile %}
      <div class="profile-banner d-flex flex-column flex-sm-row align-items-center mb-5 p-4 rounded" style="background-color: var(--global-code-bg-color); border: 1px solid var(--global-divider-color);">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          <div class="profile-banner-image mr-sm-4 mb-3 mb-sm-0 text-center">
            <img src="{{ profile_image_path | relative_url | bust_file_cache }}" class="img-fluid rounded-circle z-depth-1" style="width: 120px; height: 120px; min-width: 120px; object-fit: cover;" alt="{{ page.profile.image }}">
          </div>
        {% endif %}
        <div class="profile-banner-info flex-grow-1 text-center text-sm-left">
          <h1 class="profile-banner-name font-weight-bold mb-1" style="font-family: var(--font-family-serif); font-size: 2.2rem; color: var(--global-text-color);">
            {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}
          </h1>
          <p class="profile-banner-subtitle text-muted mb-2" style="font-size: 1.1rem; font-family: var(--font-family-sans);">{{ page.subtitle }}</p>
          {% if page.profile.more_info %}
            <div class="profile-banner-more-info text-muted mb-3" style="font-size: 0.9rem; font-family: var(--font-family-sans);">{{ page.profile.more_info }}</div>
          {% endif %}
          {% if page.social %}
            <div class="profile-banner-social d-flex flex-wrap justify-content-center justify-content-sm-start mt-2" style="gap: 12px; font-size: 1.3rem;">
              {% include social.liquid %}
            </div>
          {% endif %}
        </div>
      </div>
    {% else %}
      <header class="post-header">
        <h1 class="post-title">
          {% if site.title == 'blank' %}
            <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>
        <p class="desc">{{ page.subtitle }}</p>
      </header>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
